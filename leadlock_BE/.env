# =============================================================================
# LeadLock AI — Environment Configuration
# =============================================================================
# Copy this file to .env and customize as needed.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://leadlock:leadlock_secret@localhost:5432/leadlock
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- AI / LLM ---
# Primary: Google Gemini (Disabled)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fallback: OpenAI (Configured for SambaNova)
OPENAI_API_KEY=5c370a3c-cd6c-4f95-aa0a-cb95e15095be
OPENAI_MODEL=Meta-Llama-3.3-70B-Instruct
OPENAI_BASE_URL=https://api.sambanova.ai/v1

# --- OpenWA WhatsApp Gateway ---
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=dev-admin-key
OPENWA_DEFAULT_SESSION_ID=9abf0402-b05f-4e11-870c-1d56b7d159c9

# --- Edge Worker ---
EDGE_WORKER_HOST=0.0.0.0
EDGE_WORKER_PORT=8001

# --- Core Service ---
CORE_SERVICE_HOST=0.0.0.0
CORE_SERVICE_PORT=8000

# --- Security ---
SECRET_KEY=change-this-to-a-random-secret-key-in-production
API_KEY=leadlock-dev-api-key

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO
